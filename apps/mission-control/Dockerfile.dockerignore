# The build context is the repository root (the image installs the libraries it uses (libs/runfile, libs/gate, libs/missions) beside Mission Control; no
# robot's package): only what the Dockerfile copies goes in.
*
!apps/mission-control/pyproject.toml
!apps/mission-control/uv.lock
!apps/mission-control/src
!libs/runfile/pyproject.toml
!libs/runfile/src
!libs/web
!libs/gate/pyproject.toml
!libs/gate/src
!libs/missions/pyproject.toml
!libs/missions/src
**/__pycache__/
