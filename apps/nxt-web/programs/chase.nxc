// Chase: a game for the dog. The robot waits; when something comes closer than NEAR it
// beeps and backs away until it is FAR again (or turns away if it has backed up for too
// long). When nothing is near for a while it wiggles and chirps to invite a chase.
// Runs for RUN_MS, then stops by itself. The dark grey button stops it at any time.
//
// No shooter in this game: the balls are small enough for a dog to swallow.
// It only sees what is in front of the ultrasonic sensor, and backs up blind.
//
// Log: chase.csv on the brick (columns in common.nxh).
//   state: 0 wait, 1 flee, 2 turn, 3 invite
//   event: 1 dog came close, 2 got away, 3 backed up too long, turning, 4 invite

#include "common.nxh"

#define NEAR        30      // cm: closer than this and the robot flees
#define FAR         60      // cm: farther than this and it has got away
#define FLEE_POWER  60
#define TURN_POWER  50
#define MAX_FLEE_MS 1500    // backing up longer than this turns it away instead
#define TURN_MS     600
#define INVITE_EVERY_MS 8000
#define RUN_MS      120000

#define WAIT   0
#define FLEE   1
#define TURN   2
#define INVITE 3

task main()
{
  SetSensorLowspeed(US);
  ResetRotationCount(TRACKS);
  log_open("chase.csv");

  int state = WAIT;
  int dist;
  int event;
  int turn_dir = 1;
  unsigned long since = elapsed();
  unsigned long last_activity = elapsed();
  string names[] = {"wait  ", "flee  ", "turn  ", "invite"};

  PlayTone(880, 150);
  Wait(1000);  // a moment to put it down

  while (elapsed() < RUN_MS) {
    dist = SensorUS(US);
    event = 0;
    unsigned long in_state = elapsed() - since;

    if (state == WAIT) {
      Off(TRACKS);
      if (dist < NEAR) {
        state = FLEE; event = 1;
        PlayTone(1400, 80);
      } else if (elapsed() - last_activity > INVITE_EVERY_MS) {
        state = INVITE; event = 4;
        PlayTone(1000, 60);
      }
    } else if (state == FLEE) {
      OnRev(TRACKS, FLEE_POWER);
      if (dist >= FAR) {  // includes NO_ECHO: nothing in range any more
        state = WAIT; event = 2;
      } else if (in_state > MAX_FLEE_MS) {
        state = TURN; event = 3;
        turn_dir = Random(2) == 0 ? 1 : -1;
      }
    } else if (state == TURN) {
      OnFwd(LEFT, turn_dir * TURN_POWER);
      OnFwd(RIGHT, -turn_dir * TURN_POWER);
      if (in_state > TURN_MS) state = WAIT;
    } else if (state == INVITE) {
      // two quick left-right wiggles
      if ((in_state / 150) % 2 == 0) { OnFwd(LEFT, 40); OnRev(RIGHT, 40); }
      else { OnRev(LEFT, 40); OnFwd(RIGHT, 40); }
      if (in_state > 600) state = WAIT;
    }

    if (event != 0) { since = elapsed(); last_activity = elapsed(); }
    if (state != WAIT) last_activity = elapsed();
    log_tick(state, dist, event);
    show("CHASE", names[state], dist);
    Wait(50);
  }

  Off(TRACKS);
  log_row(state, dist, 0);
  log_close();
  PlayTone(440, 200);
  Wait(300);
}
