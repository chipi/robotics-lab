// First program that runs on the brick by itself.
// Beeps, drives both tracks forward for 1 s, back for 1 s, stops, beeps again.
// Every 100 ms it writes time and both motors' rotation counts to first.csv on the
// brick; download or plot that file from the web UI's Programs tab afterwards.
//
// Ports checked on the robot (2026-11-14): C left track, B right track.
// Lift the car before the first run.

#define LEFT   OUT_C
#define RIGHT  OUT_B
#define TRACKS OUT_BC
#define POWER  50
#define LOG    "first.csv"

byte fh;
unsigned int written;
unsigned long t0;

void log_row()
{
  string row = NumToStr(CurrentTick() - t0);
  row = StrCat(row, ",", NumToStr(MotorRotationCount(LEFT)), ",", NumToStr(MotorRotationCount(RIGHT)));
  WriteLnString(fh, row, written);
}

void drive(char power, int steps)
{
  OnFwd(TRACKS, power);
  for (int i = 0; i < steps; i++) {
    log_row();
    Wait(100);
  }
}

task main()
{
  DeleteFile(LOG);
  if (CreateFile(LOG, 2048, fh) != LDR_SUCCESS) {
    PlayTone(200, 800);  // low tone: could not create the log file
    Wait(900);
    Stop(true);
  }
  WriteLnString(fh, "ms,left,right", written);

  ResetRotationCount(TRACKS);
  t0 = CurrentTick();
  PlayTone(880, 200);
  Wait(300);

  drive(POWER, 10);
  drive(-POWER, 10);
  Off(TRACKS);
  log_row();

  CloseFile(fh);
  PlayTone(440, 200);
  Wait(300);
}
