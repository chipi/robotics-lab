{
  "id": null,
  "uid": "robotics-lab-live",
  "title": "Robotics lab: live",
  "description": "Mission Control's telemetry (docs/wip/TELEMETRY-RETENTION-DESIGN.md): robots, goals, anomalies, stops, errors. Labels robot_id, robot_kind, host_kind (RFC-0025). The datasource variables are chosen at the top.",
  "tags": ["robotics-lab", "telemetry"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {"name": "ds_metrics", "label": "Metrics", "type": "datasource", "query": "prometheus", "current": {}, "hide": 0, "refresh": 1},
      {"name": "ds_logs", "label": "Logs", "type": "datasource", "query": "victoriametrics-logs-datasource", "current": {}, "hide": 0, "refresh": 1},
      {"name": "ds_traces", "label": "Traces", "type": "datasource", "query": "jaeger", "current": {}, "hide": 0, "refresh": 1},
      {"name": "env", "label": "Environment", "type": "custom", "query": "dev,prod,check", "multi": true, "includeAll": true, "allValue": ".*",
       "current": {"selected": true, "text": "All", "value": "$__all"}, "options": [], "hide": 0}
    ]
  },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Robots online",
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${ds_metrics}"},
      "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "${ds_metrics}"}, "legendFormat": "online",
                   "expr": "sum(max by (robot_id) (last_over_time({__name__=\"robotics_lab.robot.online\",deployment.environment.name=~\"${env:regex}\"}[5m])))"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value"},
      "fieldConfig": {"defaults": {"unit": "none", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []}
    },
    {
      "id": 2, "type": "stat", "title": "Lock held",
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${ds_metrics}"},
      "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "${ds_metrics}"}, "legendFormat": "locked",
                   "expr": "sum(max by (robot_id) (last_over_time({__name__=\"robotics_lab.robot.lock_held\",deployment.environment.name=~\"${env:regex}\"}[5m])))"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value"},
      "fieldConfig": {"defaults": {"unit": "none", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}]}}, "overrides": []}
    },
    {
      "id": 3, "type": "stat", "title": "Goals active",
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${ds_metrics}"},
      "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "${ds_metrics}"}, "legendFormat": "active",
                   "expr": "sum(max by (robot_id) (last_over_time({__name__=\"robotics_lab.goals.active\",deployment.environment.name=~\"${env:regex}\"}[5m])))"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value"},
      "fieldConfig": {"defaults": {"unit": "none"}, "overrides": []}
    },
    {
      "id": 4, "type": "timeseries", "title": "Goals finished by state",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "datasource": {"type": "prometheus", "uid": "${ds_metrics}"},
      "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "${ds_metrics}"}, "legendFormat": "{{state}}",
                   "expr": "sum by (state) (increase({__name__=\"robotics_lab.goals\",deployment.environment.name=~\"${env:regex}\"}[$__rate_interval]))"}],
      "fieldConfig": {"defaults": {"unit": "none", "custom": {"drawStyle": "bars", "stacking": {"mode": "normal"}}}, "overrides": []}
    },
    {
      "id": 5, "type": "timeseries", "title": "Goal duration p95",
      "description": "From the histogram's buckets, which are the SDK's default bounds (0, 5, 10, 25, 50 ... s): coarse for short goals.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "datasource": {"type": "prometheus", "uid": "${ds_metrics}"},
      "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "${ds_metrics}"}, "legendFormat": "p95",
                   "expr": "histogram_quantile(0.95, sum by (le) (rate({__name__=\"robotics_lab.goal.duration_bucket\",deployment.environment.name=~\"${env:regex}\"}[$__rate_interval])))"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "id": 6, "type": "timeseries", "title": "Anomalies by severity",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13},
      "datasource": {"type": "prometheus", "uid": "${ds_metrics}"},
      "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "${ds_metrics}"}, "legendFormat": "{{severity}}",
                   "expr": "sum by (severity) (increase({__name__=\"robotics_lab.anomalies\",deployment.environment.name=~\"${env:regex}\"}[$__rate_interval]))"}],
      "fieldConfig": {"defaults": {"unit": "none", "custom": {"drawStyle": "bars", "stacking": {"mode": "normal"}}}, "overrides": []}
    },
    {
      "id": 7, "type": "timeseries", "title": "Stops and errors",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13},
      "datasource": {"type": "prometheus", "uid": "${ds_metrics}"},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "${ds_metrics}"}, "legendFormat": "stops",
         "expr": "sum(increase({__name__=\"robotics_lab.stops\",deployment.environment.name=~\"${env:regex}\"}[$__rate_interval]))"},
        {"refId": "B", "datasource": {"type": "prometheus", "uid": "${ds_metrics}"}, "legendFormat": "errors",
         "expr": "sum(increase({__name__=\"robotics_lab.errors\",deployment.environment.name=~\"${env:regex}\"}[$__rate_interval]))"}
      ],
      "fieldConfig": {"defaults": {"unit": "none", "custom": {"drawStyle": "bars"}}, "overrides": []}
    },
    {
      "id": 8, "type": "logs", "title": "Anomaly log",
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 21},
      "datasource": {"type": "victoriametrics-logs-datasource", "uid": "${ds_logs}"},
      "targets": [{"refId": "A", "datasource": {"type": "victoriametrics-logs-datasource", "uid": "${ds_logs}"}, "queryType": "instant", "maxLines": 200,
                   "expr": "\"service.name\":\"robotics-lab-mission-control\" \"event.kind\":anomaly \"deployment.environment.name\":~\"${env:regex}\" | sort by (_time) desc"}],
      "options": {"showTime": true, "wrapLogMessage": true, "sortOrder": "Descending"}
    },
    {
      "id": 9, "type": "table", "title": "Recent goal traces",
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 30},
      "datasource": {"type": "jaeger", "uid": "${ds_traces}"},
      "targets": [{"refId": "A", "datasource": {"type": "jaeger", "uid": "${ds_traces}"}, "queryType": "search",
                   "service": "robotics-lab-mission-control", "operation": "goal.run", "limit": 20}]
    }
  ]
}
